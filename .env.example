# Copy to .env (never commit it). RPC credentials of the node: rpcuser/rpcpassword (or an rpcauth user)
# in ~/.palladium/palladium.conf.
PLM_RPC_USER=username
PLM_RPC_PASSWORD=change-me
#CACHE_MB=1200
#REPORT_SERVICES=tcp://electrum.example.com:50001
#ELECTRUMX_TCP_PORT=50001

# SSL (port 50002): on by default, self-signed certificate generated once and kept in the electrumx-ssl volume.
#SSL_ENABLED=true
# name (or IP) of the server, written in the generated certificate
#SSL_HOSTNAME=electrum.example.com
#ELECTRUMX_SSL_PORT=50002
# your own certificate (paths inside the container; mount the files, see DEPLOY.md):
#SSL_CERTFILE=/certs/fullchain.pem
#SSL_KEYFILE=/certs/privkey.pem
